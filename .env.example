# WalletConnect / Reown project id (free): https://cloud.reown.com
# Bắt buộc để bật WalletConnect trong RainbowKit. Bỏ trống vẫn dùng được ví injected (MetaMask...).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# CoinGecko demo API key (free): https://www.coingecko.com/en/api/pricing
# CHƯA CÓ CODE NÀO ĐỌC BIẾN NÀY. Token list còn giữ sẵn coingeckoId/coingeckoPlatform cho
# phần hiển thị giá sau này; đến lúc đó biến này mới có tác dụng. Bỏ trống là đúng.
COINGECKO_API_KEY=

# Google Gemini API key (có free tier): https://aistudio.google.com/apikey
# KHÔNG có NEXT_PUBLIC_ -> chỉ dùng phía server (Route Handler /api/chat). Bỏ trống
# thì trợ lý không xuất hiện; app vẫn chạy bình thường.
GEMINI_API_KEY=
